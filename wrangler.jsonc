{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // 必须与 Cloudflare Dashboard 中的 Worker 名称完全一致，否则 Workers Builds 会构建失败
  "name": "cf-static",
  "compatibility_date": "2026-10-06",
  // 纯静态托管：不写 main，Cloudflare 只负责上传并分发 life/ 下的文件
  "assets": {
    "directory": "./life",
    // 未命中静态文件时回退到 index.html（单页 PWA 友好）
    "not_found_handling": "single-page-application"
  }
}
